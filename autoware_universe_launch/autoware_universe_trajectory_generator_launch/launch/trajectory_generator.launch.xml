<?xml version="1.0" encoding="UTF-8"?>
<!--
  Trajectory Generator Launch File
  This launch file orchestrates the generator stage of the generator-selector planning pipeline.
  See: https://github.com/autowarefoundation/autoware/issues/6292

  Generator stage:
    Multiple planners run in parallel, each producing CandidateTrajectories.
    A Trajectory Concatenator merges all candidates into a single CandidateTrajectories message.

  Topic flow:
    /planning/mission_planning/route (LaneletRoute)
      -> Robotics-Based Planner -> /planning/generator/robotics_based/candidate_trajectories
      -> AI-Based Planner       -> /planning/generator/ai_based/candidate_trajectories
      -> Trajectory Concatenator -> /planning/generator/candidate_trajectories (merged)
-->
<launch>
  <!-- ============================================================ -->
  <!-- Arguments: generator selection                               -->
  <!-- ============================================================ -->
  <arg name="use_robotics_based_planner" default="true" description="enable robotics-based trajectory planner"/>
  <arg name="use_ai_based_planner" default="false" description="enable AI-based trajectory planner (e.g., diffusion planner)"/>

  <!-- ============================================================ -->
  <!-- Arguments: common                                            -->
  <!-- ============================================================ -->
  <arg name="vehicle_param_file" description="vehicle info param file path"/>
  <arg name="pointcloud_container_name" default="pointcloud_container" description="pointcloud container name"/>
  <arg name="enable_all_modules_auto_mode" default="false" description="enable all module's auto mode"/>
  <arg name="is_simulation" default="false" description="simulation flag"/>

  <!-- ============================================================ -->
  <!-- Arguments: input topics                                      -->
  <!-- ============================================================ -->
  <arg name="input_objects_topic_name" default="/perception/object_recognition/objects" description="input objects topic"/>
  <arg name="input_pointcloud_topic_name" default="/perception/obstacle_segmentation/pointcloud" description="input pointcloud topic"/>

  <!-- ============================================================ -->
  <!-- Arguments: robotics-based planner config paths               -->
  <!-- ============================================================ -->
  <!-- common -->
  <arg name="common_config_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/common" description="common planning config path"/>
  <arg name="common_param_path" default="$(var common_config_path)/common.param.yaml" description="common param path"/>
  <arg name="nearest_search_param_path" default="$(var common_config_path)/nearest_search.param.yaml" description="nearest search param path"/>
  <arg name="costmap_generator_param_path" default="$(var common_config_path)/costmap_generator.param.yaml" description="costmap generator param path"/>

  <!-- behavior path planner -->
  <arg name="behavior_path_config_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner" description="behavior path planner config base path"/>

  <!-- behavior velocity planner -->
  <arg name="behavior_velocity_config_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner" description="behavior velocity planner config base path"/>

  <!-- motion planning -->
  <arg name="motion_config_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/lane_driving/motion_planning" description="motion planning config base path"/>

  <!-- parking -->
  <arg name="freespace_planner_param_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/parking/freespace_planner/freespace_planner.param.yaml" description="freespace planner param path"/>

  <!-- ============================================================ -->
  <!-- Robotics-Based Planner (wraps existing scenario planning)    -->
  <!-- ============================================================ -->
  <group if="$(var use_robotics_based_planner)">
    <push-ros-namespace namespace="generator/robotics_based"/>

    <include file="$(find-pkg-share autoware_universe_planning_launch)/launch/scenario_planning/scenario_planning.launch.xml">
      <arg name="enable_all_modules_auto_mode" value="$(var enable_all_modules_auto_mode)"/>
      <arg name="is_simulation" value="$(var is_simulation)"/>
      <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
      <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
    </include>
  </group>

  <!-- ============================================================ -->
  <!-- AI-Based Planner (e.g., Diffusion Planner)                   -->
  <!-- ============================================================ -->
  <!-- Placeholder: AI-based planner will be integrated here.
       When available, it will subscribe to the route and publish
       CandidateTrajectories on /planning/generator/ai_based/candidate_trajectories -->

  <!-- ============================================================ -->
  <!-- Trajectory Concatenator                                      -->
  <!-- ============================================================ -->
  <!-- Merges candidate trajectories from all generators into a single message.
       Input:  /planning/generator/*/candidate_trajectories (CandidateTrajectories)
       Output: /planning/generator/candidate_trajectories (CandidateTrajectories) -->
  <!-- Note: When only one generator is active, this node acts as a pass-through. -->
</launch>
